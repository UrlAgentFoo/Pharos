/*--------------------------------*- C++ -*----------------------------------*\
  A jet through a slot in a wall: a small 2D case for Pharos (Re = 100 at 1 m/s upstream).
\*---------------------------------------------------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }

application     pimpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         40;
deltaT          0.01;
writeControl    adjustable;
writeInterval   0.5;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;
adjustTimeStep  yes;
maxCo           0.9;
