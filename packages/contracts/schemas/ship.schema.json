{
  "additionalProperties": false,
  "$id": "ship.schema.json",
  "title": "Pharos ship",
  "type": "object",
  "required": [
    "id",
    "version",
    "image",
    "operations"
  ],
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "image": {
      "minLength": 1,
      "description": "Container image, pinned by digest (name@sha256:…) for verified ships.",
      "type": "string"
    },
    "mode": {
      "description": "cli (default) or http to keep a model warm.",
      "anyOf": [
        {
          "const": "cli",
          "type": "string"
        },
        {
          "const": "http",
          "type": "string"
        }
      ]
    },
    "summary": {
      "type": "string"
    },
    "citation": {
      "type": "string"
    },
    "license": {
      "description": "SPDX licence id of the tool, e.g. GPL-3.0-only.",
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "gpu": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "vendor",
            "optional"
          ],
          "properties": {
            "vendor": {
              "const": "nvidia",
              "type": "string"
            },
            "optional": {
              "description": "true: runs on CPU too, only slower.",
              "type": "boolean"
            }
          }
        },
        "memory_gb": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "disk_gb": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "network": {
          "description": "none (default): no network while running.",
          "anyOf": [
            {
              "const": "none",
              "type": "string"
            },
            {
              "const": "download",
              "type": "string"
            }
          ]
        }
      }
    },
    "operations": {
      "minProperties": 1,
      "additionalProperties": false,
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "summary",
            "command",
            "outputs"
          ],
          "properties": {
            "summary": {
              "minLength": 1,
              "description": "One sentence: what the operation does. Searched and shown to the assistant.",
              "type": "string"
            },
            "command": {
              "minLength": 1,
              "description": "Command template. `{param}` is replaced by a parameter's value; inputs are mounted at /in/<name>.",
              "type": "string"
            },
            "inputs": {
              "description": "Empty for operations that start from parameters alone.",
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name",
                  "kind",
                  "formats"
                ],
                "properties": {
                  "name": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "const": "volume",
                        "type": "string"
                      },
                      {
                        "const": "labels",
                        "type": "string"
                      },
                      {
                        "const": "tracks",
                        "type": "string"
                      },
                      {
                        "const": "table",
                        "type": "string"
                      },
                      {
                        "const": "mesh",
                        "type": "string"
                      },
                      {
                        "const": "splat",
                        "type": "string"
                      },
                      {
                        "const": "sim-case",
                        "type": "string"
                      },
                      {
                        "const": "video",
                        "type": "string"
                      }
                    ]
                  },
                  "formats": {
                    "minItems": 1,
                    "description": "Formats the operation reads directly.",
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "const": "ome-zarr",
                          "type": "string"
                        },
                        {
                          "const": "ome-tiff",
                          "type": "string"
                        },
                        {
                          "const": "tiff",
                          "type": "string"
                        },
                        {
                          "const": "czi",
                          "type": "string"
                        },
                        {
                          "const": "nd2",
                          "type": "string"
                        },
                        {
                          "const": "lif",
                          "type": "string"
                        },
                        {
                          "const": "csv",
                          "type": "string"
                        },
                        {
                          "const": "parquet",
                          "type": "string"
                        },
                        {
                          "const": "json",
                          "type": "string"
                        },
                        {
                          "const": "ply",
                          "type": "string"
                        },
                        {
                          "const": "vtk",
                          "type": "string"
                        },
                        {
                          "const": "mp4",
                          "type": "string"
                        },
                        {
                          "const": "openfoam-case",
                          "type": "string"
                        }
                      ]
                    }
                  },
                  "optional": {
                    "type": "boolean"
                  },
                  "needs": {
                    "minItems": 1,
                    "description": "What the data must already be, beyond its kind: solved = a simulation case that has been run (has results).",
                    "type": "array",
                    "items": {
                      "const": "solved",
                      "type": "string"
                    }
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            },
            "parameters": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                  },
                  "type": {
                    "anyOf": [
                      {
                        "const": "number",
                        "type": "string"
                      },
                      {
                        "const": "integer",
                        "type": "string"
                      },
                      {
                        "const": "string",
                        "type": "string"
                      },
                      {
                        "const": "boolean",
                        "type": "string"
                      },
                      {
                        "const": "enum",
                        "type": "string"
                      }
                    ]
                  },
                  "label": {
                    "description": "Dialog label; defaults to the name.",
                    "type": "string"
                  },
                  "description": {
                    "description": "One sentence for the dialog tooltip and the assistant.",
                    "type": "string"
                  },
                  "default": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "options": {
                    "minItems": 1,
                    "description": "Allowed values (enum only).",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "unit": {
                    "description": "e.g. px, µm, s, m/s",
                    "type": "string"
                  }
                }
              }
            },
            "outputs": {
              "minItems": 1,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name",
                  "kind",
                  "format",
                  "path"
                ],
                "properties": {
                  "name": {
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "type": "string"
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "const": "volume",
                        "type": "string"
                      },
                      {
                        "const": "labels",
                        "type": "string"
                      },
                      {
                        "const": "tracks",
                        "type": "string"
                      },
                      {
                        "const": "table",
                        "type": "string"
                      },
                      {
                        "const": "mesh",
                        "type": "string"
                      },
                      {
                        "const": "splat",
                        "type": "string"
                      },
                      {
                        "const": "sim-case",
                        "type": "string"
                      },
                      {
                        "const": "video",
                        "type": "string"
                      }
                    ]
                  },
                  "format": {
                    "anyOf": [
                      {
                        "const": "ome-zarr",
                        "type": "string"
                      },
                      {
                        "const": "ome-tiff",
                        "type": "string"
                      },
                      {
                        "const": "tiff",
                        "type": "string"
                      },
                      {
                        "const": "czi",
                        "type": "string"
                      },
                      {
                        "const": "nd2",
                        "type": "string"
                      },
                      {
                        "const": "lif",
                        "type": "string"
                      },
                      {
                        "const": "csv",
                        "type": "string"
                      },
                      {
                        "const": "parquet",
                        "type": "string"
                      },
                      {
                        "const": "json",
                        "type": "string"
                      },
                      {
                        "const": "ply",
                        "type": "string"
                      },
                      {
                        "const": "vtk",
                        "type": "string"
                      },
                      {
                        "const": "mp4",
                        "type": "string"
                      },
                      {
                        "const": "openfoam-case",
                        "type": "string"
                      }
                    ]
                  },
                  "path": {
                    "pattern": "^/out/",
                    "description": "Where the operation writes this output, under /out.",
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            },
            "cache": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "deterministic"
              ],
              "properties": {
                "deterministic": {
                  "description": "Same inputs and parameters always give the same outputs, so results can be cached.",
                  "type": "boolean"
                }
              }
            },
            "edam": {
              "pattern": "^operation_\\d+$",
              "description": "EDAM operation term.",
              "type": "string"
            }
          }
        }
      }
    }
  }
}
